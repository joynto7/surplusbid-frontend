# Base URL of surplusbid-backend, including the /api/v1 prefix.
# Used by the server (route handlers, server components, proxy) and the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Public URL of this frontend (used for Stripe return URLs and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe publishable key (pk_test_...) for the Payment Element.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Keep in sync with surplusbid-backend's DEPOSIT_PERCENT / PAYMENT_DEADLINE_HOURS.
NEXT_PUBLIC_DEPOSIT_PERCENT=10
NEXT_PUBLIC_PAYMENT_DEADLINE_HOURS=48

# Optional: must be the same value as the backend's JWT_ACCESS_SECRET. When set,
# the proxy verifies the access-token signature instead of only decoding it.
JWT_ACCESS_SECRET=

# Demo accounts. The login page's demo buttons fill these into the form and sign in.
# With an empty password, that role's demo button shows an error instead of signing in.
DEMO_ADMIN_EMAIL=admin@surplusbid.com
DEMO_ADMIN_PASSWORD=
DEMO_SELLER_EMAIL=seller@surplusbid.com
DEMO_SELLER_PASSWORD=
DEMO_BUYER_EMAIL=buyer@surplusbid.com
DEMO_BUYER_PASSWORD=
