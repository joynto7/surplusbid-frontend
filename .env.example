# Base URL of the surplusbid-backend API, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Stripe publishable key (pk_test_… for local dev) — needed for checkout.
VITE_STRIPE_PUBLISHABLE_KEY=

# Keep in sync with surplusbid-backend's DEPOSIT_PERCENT / PAYMENT_DEADLINE_HOURS.
VITE_DEPOSIT_PERCENT=10
VITE_PAYMENT_DEADLINE_HOURS=48
